# Database
DATABASE_URL=

# App Configuration
APP_ENV=
DEBUG=
SECRET_KEY=
AUTH_ENABLED=
# Access-token lifetime in minutes. 0 = 60 in production, 7 days otherwise.
# Production refuses anything above 1440 (24h); use POST /auth/refresh instead.
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=14
# Staff email: log (writes invite/reset links to the app log) or smtp.
EMAIL_PROVIDER=log
EMAIL_FROM=AgroOS <no-reply@agroos.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO_DATA=
# Local/dev: true (default). On Render with a pre-deploy `alembic upgrade head`, set false.
AUTO_MIGRATE_ON_STARTUP=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
RATE_LIMIT_SMS_PER_MINUTE=5
RATE_LIMIT_DUES_PER_MINUTE=10

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Moolre API
MOOLRE_ENV=
MOOLRE_API_URL=
MOOLRE_API_USER=
MOOLRE_API_KEY=
MOOLRE_API_PUBKEY=
MOOLRE_API_VASKEY=

# Moolre Merchant / Account
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_MERCHANT_ID=
MOOLRE_MERCHANT_CODE=
MOOLRE_WEBHOOK_SECRET=
MOOLRE_USSD_SECRET=
AGROOS_USSD_CODE=*919*4020#
USSDK_HOOK_SECRET=
USSD_CALLBACK_SECRET=

# AgroOS Deployment
AGROOS_BASE_URL=
WEBHOOK_CALLBACK_PATH=/webhooks/payment

# Cooperative Defaults
DEFAULT_CURRENCY=
DEFAULT_SMS_SENDER_ID=

# Agro-AI
AGRO_AI_MODEL_PATH=
AGRO_AI_AUDIT_LOG_PATH=
AGRO_AI_REQUIRE_ARTIFACT=

# Error tracking (optional)
SENTRY_DSN=

# Weights & Biases experiment tracking
WANDB_PROJECT=
WANDB_ENTITY=
WANDB_MODE=
